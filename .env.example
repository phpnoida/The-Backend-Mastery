# Copy this file to .env.development (or .env.staging / .env.production)
# and fill in real values. Never commit those files.
#
# NODE_ENV is NOT set here — it is injected by the npm script or deployment platform.

PORT=6001

# MongoDB
MONGO_URI=mongodb://localhost:27017/your-db-name

# CORS — comma-separated list of browser origins allowed to call this API.
# Leave default for local dev; set real domains in staging/production.
CORS_ORIGINS=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
